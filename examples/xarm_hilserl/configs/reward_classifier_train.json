{
  "dataset": {
    "repo_id": "local/xarm7_hilserl_classifier_cropped_resized",
    "image_transforms": {
      "enable": true
    },
    "root": null
  },
  "reward_model": {
    "type": "reward_classifier",
    "model_name": "lerobot/resnet10",
    "model_type": "cnn",
    "num_cameras": 3,
    "num_classes": 2,
    "hidden_dim": 256,
    "dropout_rate": 0.1,
    "learning_rate": 0.0001,
    "device": "cuda",
    "input_features": {
      "observation.images.wrist": {
        "type": "VISUAL",
        "shape": [
          3,
          128,
          128
        ]
      },
      "observation.images.side": {
        "type": "VISUAL",
        "shape": [
          3,
          128,
          128
        ]
      },
      "observation.images.front": {
        "type": "VISUAL",
        "shape": [
          3,
          128,
          128
        ]
      }
    },
    "push_to_hub": false
  },
  "batch_size": 16,
  "num_workers": 4,
  "steps": 5000,
  "log_freq": 10,
  "save_freq": 1000,
  "save_checkpoint": true,
  "seed": 2,
  "resume": false,
  "wandb": {
    "enable": false,
    "project": "xarm7-reward-classifier"
  },
  "job_name": "xarm7_reward_classifier_v3"
}
